---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}
  {% if item.layout == "page" and item.sitemap != false %}
  <url>
    <loc>{{ site.url }}{{ item.url | replace: 'index.html', '' }}</loc>
  </url>
  {% endif %}
{% endfor %}
</urlset>
